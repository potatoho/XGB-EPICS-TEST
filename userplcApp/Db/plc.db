record(ai, "$(P)rx_01") {
  field(DTYP, "stream")
  field(INP,  "@plc.proto read_rx01_seq $(PORT)")
  field(SCAN, ".1 second")
  field(PHAS, "0")
  field(LINR, "NO CONVERSION")
}

record(bi, "$(P)rx_02") {
  field(DTYP, "stream")
  field(INP,  "@plc.proto read_rx02_seq $(PORT)")
  field(SCAN, ".1 second")
  field(PHAS, "0")
  field(ZNAM, "0")
  field(ONAM, "1")
}


# ---- 수동 송신 ----
record(ao, "$(P)tx_01") {
  field(DTYP, "stream")
  field(OUT, "@plc.proto tx_01 $(PORT)")
  field(PREC, "0")
  field(LINR, "NO CONVERSION")
}

record(bo, "$(P)tx_02") {
  field(DTYP, "stream")
  field(OUT, "@plc.proto tx_02 $(PORT)")
  field(ZNAM, "0")
  field(ONAM, "1")
}

record(bo, "$(P)tx_03") {
  field(DTYP, "stream")
  field(OUT, "@plc.proto tx_03 $(PORT)")
  field(ZNAM, "0")
  field(ONAM, "1")
}
